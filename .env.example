# ======================
# BACKEND ENVIRONMENT VARIABLES
# ======================

# Server Configuration
PORT=5030
NODE_ENV=development

# Database Configuration
DATABASE_URL="mysql://root:@localhost:3308/expendables_db"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_make_it_very_long_and_random
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin Default Credentials (Change these!)
ADMIN_EMAIL=admin@expendables.com
ADMIN_PASSWORD=Admin@123

# ======================
# FRONTEND ENVIRONMENT VARIABLES
# Create .env.local in frontend folder
# ======================

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5030/api

# Site Configuration
NEXT_PUBLIC_SITE_NAME=EXPENDABLES
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Currency
NEXT_PUBLIC_CURRENCY=LKR
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs.

# Shipping
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=9999

# Payment Gateway (Placeholder - Add real credentials when integrating)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_placeholder
PAYHERE_MERCHANT_ID=placeholder
PAYHERE_MERCHANT_SECRET=placeholder

# Email Configuration (Optional - for future email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@expendables.com

# File Upload (Optional - for future cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Social Media Links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/expendables
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/expendables
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@expendables
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@expendables
